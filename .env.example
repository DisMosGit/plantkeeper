# PlantKeeper — local environment template.
#
# Copy to `.env` (`cp .env.example .env`) and adjust as needed.
# `.env` is gitignored; only this template is committed.
# The defaults below already match `docker-compose.yml`.

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=plantkeeper
POSTGRES_PASSWORD=plantkeeper
POSTGRES_DB=plantkeeper
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Kafka --------------------------------------------------------------------
# Host-side bootstrap address. Containers inside the compose network use kafka:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Valkey -------------------------------------------------------------------
VALKEY_URL=valkey://localhost:6379/0

# --- Read side (projections + Django Admin) -----------------------------------
# Development-only signing key. Django needs one; nothing here authenticates.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_DEBUG=true
# The local superuser Django Admin renders as. Empty restores the login form.
DJANGO_AUTO_LOGIN_USER=admin
# Every projection gets its own consumer group: <prefix>-garden, <prefix>-care, …
READ_SIDE_CONSUMER_GROUP_PREFIX=plantkeeper-read

# --- Write side (sagas: the worker's consumers and timers) ---------------------
# Every saga gets its own consumer group: <prefix>-onboard-plant, <prefix>-adaptive-watering, …
WORKER_CONSUMER_GROUP_PREFIX=plantkeeper-worker
# How often the missed-care tick looks for due and overdue schedules (the grace
# period itself is 24 hours and is not configurable).
MISSED_CARE_CHECK_INTERVAL_SECONDS=60
# How often the daily catalogue synchronisation is requested.
SPECIES_SYNC_INTERVAL_SECONDS=86400
# How often sagas left running by a crash are looked for, how long they must have
# been untouched to count as crashed, and how often one is retried before it is
# left for an operator.
SAGA_RECOVERY_INTERVAL_SECONDS=30
SAGA_RECOVERY_STALE_AFTER_SECONDS=60
SAGA_RECOVERY_MAX_ATTEMPTS=5

# --- Telemetry ingress (the raw stream and the readings table) -----------------
# Where `tools/iot-simulator` publishes; not a domain-event topic.
TELEMETRY_RAW_TOPIC=telemetry.raw
# The ingress's own group. Not prefixed from WORKER_CONSUMER_GROUP_PREFIX: it reads
# a raw topic rather than an event topic, so it is named rather than derived.
TELEMETRY_INGEST_CONSUMER_GROUP=plantkeeper-telemetry-ingest
# How many months past the current one `write_telemetry.sensor_readings` keeps
# partitioned, and how often the worker looks for a month that needs creating.
# A reading always has the catch-all partition to land in; the month is the
# optimisation, so a stopped worker costs index size, never a failed write.
TELEMETRY_PARTITION_MONTHS_AHEAD=3
TELEMETRY_PARTITION_CHECK_INTERVAL_SECONDS=86400

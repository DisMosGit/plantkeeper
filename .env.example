# PlantKeeper — local environment template.
#
# Copy to `.env` (`cp .env.example .env`) and adjust as needed.
# `.env` is gitignored; only this template is committed.
# The defaults below already match `docker-compose.yml`.

# --- Postgres: the write instance ---------------------------------------------
# The write schemas (`write_*`, `write_shared`) live here. The API, the workers
# and Alembic (`make migrate`) address it through these five values.
POSTGRES_USER=plantkeeper
POSTGRES_PASSWORD=plantkeeper
POSTGRES_DB=plantkeeper
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Postgres: the read instance ----------------------------------------------
# The read side's own database: `read_analytics` (the projection read models and
# the `processed_events` ledger) lives here, created by Django's migration. Django
# (`make admin`, `make migrate`) and the API's read-only query engine address it
# through these five values.
#
# Small machine? Point these at the write instance — same host, port 5432, database
# and credentials — and both sides share one Postgres again. The split is
# configuration, not code; `docs/runbooks/local-topology.md` holds the rollback.
READ_POSTGRES_USER=plantkeeper
READ_POSTGRES_PASSWORD=plantkeeper
READ_POSTGRES_DB=plantkeeper
READ_POSTGRES_HOST=localhost
READ_POSTGRES_PORT=5433

# --- Kafka --------------------------------------------------------------------
# Host-side bootstrap address. Containers inside the compose network use kafka:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Valkey -------------------------------------------------------------------
VALKEY_URL=valkey://localhost:6379/0

# --- Read side (projections + Django Admin + client queries) -------------------
# The read side runs on its own Postgres instance; the URL is the
# `READ_POSTGRES_*` block above, shared with the API's read-only query engine.
# Development-only signing key. Django needs one; nothing here authenticates.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_DEBUG=true
# The local superuser Django Admin renders as. Empty restores the login form.
DJANGO_AUTO_LOGIN_USER=admin
# Every projection gets its own consumer group: <prefix>-garden, <prefix>-care, …
READ_SIDE_CONSUMER_GROUP_PREFIX=plantkeeper-read

# --- Write side (sagas: the worker's consumers and timers) ---------------------
# Every saga gets its own consumer group: <prefix>-onboard-plant, <prefix>-adaptive-watering, …
WORKER_CONSUMER_GROUP_PREFIX=plantkeeper-worker
# How often the missed-care tick looks for due and overdue schedules (the grace
# period itself is 24 hours and is not configurable).
MISSED_CARE_CHECK_INTERVAL_SECONDS=60
# How often the daily catalogue synchronisation is requested.
SPECIES_SYNC_INTERVAL_SECONDS=86400
# How often sagas left running by a crash are looked for, how long they must have
# been untouched to count as crashed, and how often one is retried before it is
# left for an operator.
SAGA_RECOVERY_INTERVAL_SECONDS=30
SAGA_RECOVERY_STALE_AFTER_SECONDS=60
SAGA_RECOVERY_MAX_ATTEMPTS=5

# --- Consumers: retries and the dead-letter topic ------------------------------
# How a consumer treats a delivery whose handler raised: a broken domain rule is
# moved aside at once, anything else is retried this many times with an
# exponential backoff and then moved aside to `plantkeeper.dlq.v1` as well. Both
# subscriber sets — the worker's consumers and Django's projections — use these.
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_RETRY_INITIAL_WAIT_SECONDS=0.5
CONSUMER_RETRY_MAX_WAIT_SECONDS=10

# --- Telemetry ingress (the raw stream and the readings table) -----------------
# Where `tools/iot-simulator` publishes; not a domain-event topic.
TELEMETRY_RAW_TOPIC=telemetry.raw
# The ingress's own group. Not prefixed from WORKER_CONSUMER_GROUP_PREFIX: it reads
# a raw topic rather than an event topic, so it is named rather than derived.
TELEMETRY_INGEST_CONSUMER_GROUP=plantkeeper-telemetry-ingest
# How many months past the current one `write_telemetry.sensor_readings` keeps
# partitioned, and how often the worker looks for a month that needs creating.
# A reading always has the catch-all partition to land in; the month is the
# optimisation, so a stopped worker costs index size, never a failed write.
TELEMETRY_PARTITION_MONTHS_AHEAD=3
TELEMETRY_PARTITION_CHECK_INTERVAL_SECONDS=86400
# How long raw readings are kept, in whole months. The same job drops the partition
# of every month that lies entirely beyond this window; the rollups on the read
# instance outlive the rows they were computed from (docs/telemetry.md).
TELEMETRY_RETENTION_MONTHS=12
# How often the silence timer looks for a sensor that has stopped reporting. The
# period itself is the domain's Sensor.OFFLINE_AFTER (10 minutes); a late tick
# delays the announcement, it never misses it.
SENSOR_SILENCE_CHECK_INTERVAL_SECONDS=60

# --- Catalog: Trefle ACL + species cache (Phase 9) ----------------------------
# The Trefle access token. Never commit a real one. Left empty, the catalogue
# synchronisation runs as a no-op: `POST /api/v1/catalog/sync` still accepts the
# request, it just finds nothing to pull.
TREFLE_TOKEN=
TREFLE_BASE_URL=https://trefle.io/api/v1
# The free tier allows 60 requests/minute; the client stays one below.
TREFLE_REQUESTS_PER_MINUTE=55
TREFLE_REQUEST_TIMEOUT_SECONDS=10
# One synchronisation fetches this many species. Trefle's list endpoint carries
# no care data, so each species also costs one detail request.
TREFLE_SPECIES_LIMIT=30
TREFLE_MAX_ATTEMPTS=3
TREFLE_BREAKER_FAILURE_THRESHOLD=5
TREFLE_BREAKER_RESET_SECONDS=60
# How long a cached species entry, and the last upstream snapshot, live in Valkey.
SPECIES_CACHE_TTL_SECONDS=86400
SPECIES_SNAPSHOT_TTL_SECONDS=86400
